LIBRARY d3d8
EXPORTS
    Direct3DCreate8

    ; Dx8to12 mod-facing settings API -- see MODDING.md.
    Dx8to12_GetApiVersion
    Dx8to12_GetSettingInt
    Dx8to12_SetSettingInt
    Dx8to12_GetSettingFloat
    Dx8to12_SetSettingFloat
    Dx8to12_GetSettingBool
    Dx8to12_SetSettingBool

    ; Dx8to12 mod-facing native D3D12 rendering API -- see MODDING.md.
    Dx8to12_GetD3D12Device
    Dx8to12_GetD3D12CommandQueue
    Dx8to12_GetWindowHandle
    Dx8to12_GetBackbufferFormat
    Dx8to12_GetNumBackBuffers
    Dx8to12_RegisterRenderCallback
    Dx8to12_UnregisterRenderCallback
    Dx8to12_GetSwapChainGeneration