vsbuild/
.vscode/
private/
dumps/
build/
# Every build tree, however it is suffixed: build-x86-release-vc,
# build-x64-rt-helper, the release-mindebug A/B variants, and so on.
build-*/

# Externally supplied SDKs. NVIDIA's Streamline/DLSS binaries have their own
# licence and redistribution terms -- this is a public fork, so they are kept
# out of the repo and each developer drops their own copy in here.
third_party/streamline/
# NVIDIA NGX SDK (github.com/NVIDIA/DLSS). Vendor-licensed, same as Streamline:
# this fork is public, so the SDK is fetched by the developer, never committed.
third_party/ngx/

# Game-specific binary analysis artifacts (not for the public repo).
d3d8_calls_*.txt
d3d8calls.py
.analysis/
analysis_work/
*.log

CMakeLists.txt.user
CMakeCache.txt
CMakeFiles
CMakeScripts
Testing
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps

log.txt
test.vsh
test.vso
readings.txt

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

plan/
# Internal planning, roadmaps and cross-agent handoff notes. Local only:
# working documents, not something a reader of this repo needs.
plan/

# ETW/WPR captures and the symbol caches they drag along -- gigabytes of
# machine-specific binary, useful only on the machine that recorded them.
traces/

# Belt and braces for vendor-licensed binaries. The SDK directories above are
# already ignored, but these names are also what someone copies next to a
# build or a game while testing, and this fork is public: an NVIDIA runtime
# must never be committable by accident, from anywhere in the tree.
nvngx*.dll
nvsdk_ngx*.lib
sl.*.dll
*.addon64
